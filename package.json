{
  "name": "gongdi-ledger",
  "private": true,
  "version": "1.8.16",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "node app/server/index.mjs",
    "postbuild": "node scripts/copy-output.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test \"tests/**/*.test.ts\"",
    "test:roundtrip": "node --import ./tests/register.mjs tests/roundtrip/run.ts",
    "check": "pnpm run typecheck && pnpm test && pnpm run test:roundtrip && pnpm run build"
  },
  "dependencies": {
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "exceljs": "4.4.0",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "4.5.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "npm:rolldown-vite@7.3.1",
    "vite-tsconfig-paths": "6.1.1"
  }
}
